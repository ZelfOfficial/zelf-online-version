# Zelf API - Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# =============================================================================
# App & Server
# =============================================================================

NODE_ENV=development
PORT=3003
BASE_URL=https://example.com
ENVOS=mac
FRONTEND_URL=https://example.com
CLIENT_APP_URL=https://example.com
NODE_TLS_REJECT_UNAUTHORIZED=0
OPENCV_ENV=your-value-here


# =============================================================================
# Auth & JWT
# =============================================================================

SESSION_SECRET=your-secret-here
CONNECTION_KEY=your-secret-here
JWT_SECRET=your-secret-here
SUPER_ADMINS_JWT_SECRET=your-secret-here
ZELF_ENCRYPT_SERVER_KEY=your-secret-here


# =============================================================================
# Database
# =============================================================================

# App + Jest integration (globalSetup): `MONGODB_URI_PROD` → `MONGODB_URI` → localhost zelf_testing fallback in tests/config/test.config.js
# Optional: dedicated URI for Jest only (overrides the others for test runs)
# MONGODB_URI_TEST=
MONGODB_URI=your-value-here
# MONGODB_URI_PROD=

# =============================================================================
# Blog Markdown seed scripts (scripts/seed-blogs.js, scripts/fix-missing-descriptions.js)
# =============================================================================
# Absolute path to landing-zelf-nextjs repo root; scripts read Markdown from <LANDING_ROOT>/content/blog
# LANDING_ROOT=/Users/miguel/ai-made/landing-zelf-nextjs
# Or point directly at the blog folder:
# BLOG_CONTENT_DIR=/Users/miguel/ai-made/landing-zelf-nextjs/content/blog


# =============================================================================
# Email (Mailgun)
# =============================================================================

MAILGUN_API_KEY=your-secret-here
MAILGUN_PROXY_EMAIL=your@email.com


# =============================================================================
# IPFS (Pinata)
# =============================================================================

PINATA_API_KEY=your-secret-here
PINATA_API_SECRET=your-secret-here
PINATA_GATEWAY_URL=https://example.com
PINATA_JWT=your-value-here
_PINATA_API_KEY=your-secret-here
_PINATA_API_SECRET=your-secret-here
_PINATA_GATEWAY_URL=https://example.com
_PINATA_JWT=your-value-here


# =============================================================================
# PGP
# =============================================================================

PGP_SECRET_KEY=your-secret-here
PGP_PASSPHRASE=your-value-here
PGP_GLOBAL_SECRET_KEY=your-secret-here
PGP_GLOBAL_PASSPHRASE=your-value-here


# =============================================================================
# Zelf Proof & Token
# =============================================================================

# Zelf Encrypt 3.1.6 (Tags / ZNS legacy): Koa posts to {ZELF_PROOF_URL}/zelf/{encrypt,decrypt,preview}
# Default in Core/config.js is https://v4.zelf.world if unset.
# ZELF_PROOF_URL=https://v4.zelf.world
ZELF_PROOF_API_KEY=your-secret-here
# Skip Turbo/Arweave uploads for local dev and QA (IPFS-only lease/create). Legacy ZNS v2 and Domain.isArweaveEnabled() honor this flag.
SKIP_ARWEAVE=true

# Zelf Encrypt 4.0.0 (ZelfID online /api/zelf-ids, HumanAuthn): Koa posts to {ZELF_PROOF_V4_URL}{ZELF_PROOF_V4_PATH_PREFIX}/{encrypt,decrypt,preview}
# Face Certificates and signed proofs live on https://v4.zelf.world (not v3). Path prefix /zelf-v4 → host 7778.
# Separate API key from 3.1.6 — do not reuse ZELF_PROOF_API_KEY here.
# ZELF_PROOF_V4_URL=https://v4.zelf.world
ZELF_PROOF_API_KEY_V4=your-secret-here
# ZELF_PROOF_V4_PATH_PREFIX=/zelf-v4
# USD price per ZNS token for rewards / subscription grant conversion (e.g. 0.05).
REWARD_PRICE=0.05
PRICE_ENV=your-value-here

# Plan & Billing API usage rates (USD). Monthly ZNS grant after invoice.payment_succeeded ≈ ceil(plan_catalog_usd_monthly / REWARD_PRICE).
API_USAGE_ENCRYPT_USD=0.10
API_USAGE_ACTIVE_USER_USD=0.10
API_USAGE_DECRYPT_WITH_LIVENESS_USD=0.05
API_USAGE_DECRYPT_NO_LIVENESS_USD=0.01
# Optional; default 10 — first N decrypts/month included when liveness applies (dashboard copy).
# API_USAGE_DECRYPT_INCLUDED_PER_MONTH=10
ZK1=your-value-here
ZELF1=your-value-here


# =============================================================================
# Arweave
# =============================================================================

ARWAVE_ENV=your-value-here
# Optional overrides — defaults live in Core/config.js (ARWEAVE_DEFAULT_*)
# ARWEAVE_PUBLIC_GATEWAY_URL=https://arweave.net
# ARWEAVE_GRAPHQL_GATEWAYS=https://arweave-search.goldsky.com,https://arweave.net,https://turbo-gateway.com,https://ardrive.net
# ARWEAVE_ARNS_GATEWAY_HOST=arweave.net
ARWEAVE_OWNER=your-value-here
ARWAVE_N=your-value-here
ARWAVE_E=your-value-here
ARWAVE_D=your-value-here
ARWAVE_P=your-value-here
ARWAVE_Q=your-value-here
ARWAVE_DP=your-value-here
ARWAVE_DQ=your-value-here
ARWAVE_QI=your-value-here
_ARWEAVE_OWNER=your-value-here
_ARWAVE_N=your-value-here
_ARWAVE_E=your-value-here
_ARWAVE_D=your-value-here
_ARWAVE_P=your-value-here
_ARWAVE_Q=your-value-here
_ARWAVE_DP=your-value-here
_ARWAVE_DQ=your-value-here
_ARWAVE_QI=your-value-here
ARWEAVE_PARENT_NAME=your-value-here
ARWEAVE_PROCESS_ID=your-id-here
ARWEAVE_TRANSACTION_ID=your-id-here
ARNS_PROCESS_ID=your-id-here
ARNS_INDEX_TRANSACTION_ID=your-id-here


# =============================================================================
# Stripe
# =============================================================================

# Public origin of the Fuse dashboard (Plan & Billing checkout success/cancel URLs).
# Defaults to FRONTEND_URL, then http://localhost:3051 (ng serve port). Production should set explicitly.
# DASHBOARD_URL=https://app.example.com

STRIPE_SECRET_KEY=your-secret-here
STRIPE_WEBHOOK_SECRET=your-secret-here
STRIPE_BASIC_PRODUCT=your-value-here
STRIPE_BASIC_PRICE_ID=your-id-here
STRIPE_PRO_PRODUCT=your-value-here
STRIPE_PRO_PRICE_ID=your-id-here
STRIPE_ENTERPRISE_PRODUCT=your-value-here
STRIPE_ENTERPRISE_PRICE_ID=your-id-here

# =============================================================================
# Solana
# =============================================================================

SOLANA_SENDER_PUBLIC_KEY=your-secret-here
SOLANA_NODE_SECRET=your-secret-here
SOLANA_TOKEN_MINT_ADDRESS=0x...
# Full Solana mainnet RPC URL (SOLANA_RPC_URL takes precedence over SOLANA_RPC_ENDPOINT).
# Falls back to building the QuickNode URL from SOLANA_NODE_SECRET if neither is set.
SOLANA_RPC_URL=
SOLANA_RPC_ENDPOINT=your-value-here
SOLANA_DEV_MODE_TOKENS=true
SOLANA_SERVICE_WALLET_PRIVATE_KEY=your-secret-here
SENDER_KEY=your-secret-here


# =============================================================================
# Blockchain & RPC
# =============================================================================

# Protected RPC proxy admin: /api/rpc-callers/top, /ban, /unban need JWT + header X-RPC-Caller-Admin: <this value>
RPC_CALLER_ADMIN_SECRET=

# RPC proxy per-IP rate limits (Mongo minute windows; set RPC_RATE_LIMIT_ENABLED=false to disable)
# RPC_RATE_LIMIT_ENABLED=true
# RPC_RATE_LIMIT_PER_MINUTE=300
# RPC_RATE_LIMIT_ROLLING_MINUTES=5
# RPC_RATE_LIMIT_MAX_ROLLING=1200
# RPC_RATE_LIMIT_WINDOW_TTL_MS=7200000

# Avalanche C-Chain mainnet JSON-RPC (full URL). QuikNode puts the endpoint token in the path — paste the whole URL from the dashboard; there is no separate “API key” env unless you use a template.
# Example shape: https://<subdomain>.avalanche-mainnet.quiknode.pro/<endpoint-token>/ext/bc/C/rpc/
# Used across the API (e.g. avalanche features). The protected RPC proxy uses this unless RPC_PROXY_AVALANCHE_URL is set.
AVALANCHE_RPC_URL=https://YOUR_SUBDOMAIN.avalanche-mainnet.quiknode.pro/YOUR_ENDPOINT_TOKEN/ext/bc/C/rpc/
# Optional: only override the URL for POST /api/rpc/request (avalanche chain); if unset, AVALANCHE_RPC_URL is used.
# RPC_PROXY_AVALANCHE_URL=
# Mainnet = 43114; Fuji testnet = 43113
AVALANCHE_CHAIN_ID=43114
# Integration test npm run test:avalanche-rpc: start API (e.g. PORT=3003 npm start), MongoDB, then run the script; it uses POST /api/sessions then POST /api/rpc/request with JWT.

# Sui fullnode JSON-RPC (full URL). Used by POST /api/rpc/sui and POST /api/rpc/request with chain sui. Default in config is public mainnet if unset.
# Optional: proxy-only URL override (takes precedence over SUI_RPC_URL for the RPC proxy).
# RPC_PROXY_SUI_URL=
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
# Logical id for GET /api/rpc/chains only (Sui is not EVM — not a CAIP chain id).
SUI_CHAIN_ID=101

# TON (The Open Network) — portfolio indexer + RPC for send/seqno
# QuickNode and similar providers: append /jsonRPC to the base URL
TON_RPC_URL=https://toncenter.com/api/v2/jsonRPC
# Optional but recommended: TonAPI Bearer + TonCenter X-API-Key (reduces 429s on confirm/lookup)
TON_API_KEY=your-secret-here
TON_INDEXER_URL=https://tonapi.io
TON_SERVICE_WALLET_ADDRESS=your-ton-service-wallet-address
# USDT Jetton master on TON mainnet (default in config if unset)
# TON_USDT_JETTON_MASTER=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
# TON_TIMEOUT_MS=30000

# Aptos official endpoints allow anonymous access, but production Indexer use
# should have a private Geomi/Aptos server key to avoid low anonymous limits.
APTOS_NETWORK=mainnet
APTOS_FULLNODE_URL=https://api.mainnet.aptoslabs.com/v1
APTOS_INDEXER_URL=https://api.mainnet.aptoslabs.com/v1/graphql
# APTOS_API_KEY=your-geomi-server-key
# APTOS_TIMEOUT_MS=30000
# APTOS_MAX_GAS_AMOUNT=200000

# Canton Network / Canton Coin (CC) — private, party-scoped Ledger API integration.
# A validator/participant or node-as-a-service provider is required. There is no public
# address indexer equivalent to conventional chains because Canton data is private.
CANTON_NETWORK=devnet
CANTON_LEDGER_API_URL=
# Base Validator API URL; optional for the initial read/prepare flow, required by some onboarding/preapproval flows.
CANTON_VALIDATOR_API_URL=
# Scan API and Canton Coin Token Standard registry. With a validator, the CC registry is commonly its scan proxy.
CANTON_SCAN_API_URL=
CANTON_REGISTRY_API_URL=
CANTON_INSTRUMENT_ID=Amulet

# Production/hosted validators should normally use OAuth2 machine-to-machine authentication.
CANTON_AUTH_METHOD=client_credentials
CANTON_AUTH_CONFIG_URL=
CANTON_AUTH_CLIENT_ID=
CANTON_AUTH_CLIENT_SECRET=
CANTON_AUTH_AUDIENCE=
CANTON_AUTH_SCOPE="openid daml_ledger_api offline_access"
# LocalNet development only: CANTON_AUTH_METHOD=self_signed plus issuer/client credentials.
CANTON_AUTH_ISSUER=
# Compatibility only; a static token expires and is not recommended for deployment.
CANTON_STATIC_TOKEN=

# Temporary QA authorization boundary. Comma-separated party IDs that this shared
# backend may read or use as transfer senders. Replace with durable Zelf ID/session
# ownership before production. Never enable unbound parties in production.
CANTON_ALLOWED_PARTIES=
CANTON_ALLOW_UNBOUND_PARTIES=false
CANTON_TIMEOUT_MS=30000
# CANTON_LIVE_TEST_PARTY_ID=alice::1220...
# If you set RPC_PROXY_ALLOWED_METHODS, include EVM, Solana, and Sui methods you need (see Core/config.js defaults).
# Upstream axios timeout for POST /api/rpc/* and /api/protected/rpc/* (ms). Default 45000; raise if Solana simulate/send times out.
# RPC_PROXY_TIMEOUT_MS=45000

# Extension JWT-only RPC proxy (POST /api/protected/rpc/:chainKey, requires Bearer session JWT).
# If unset, each falls back to the same URL as the public RPC proxy chain (RPC_PROXY_* / *RPC_URL).
EXTENSION_ETHEREUM_RPC_URL=
EXTENSION_AVALANCHE_RPC_URL=
EXTENSION_POLYGON_RPC_URL=
EXTENSION_BSC_RPC_URL=
EXTENSION_ARBITRUM_RPC_URL=
EXTENSION_OPTIMISM_RPC_URL=
EXTENSION_BASE_RPC_URL=
EXTENSION_BLOCKDAG_RPC_URL=
# Solana mainnet JSON-RPC for POST /api/protected/rpc/solana (falls back to SOLANA_RPC_URL / public mainnet).
EXTENSION_SOLANA_RPC_URL=
# Restrict GET/POST /api/protected/rpc/* by `Origin` (in addition to JWT). Empty = no Origin check.
# PROTECTED_RPC_CHROME_EXTENSION_IDS=daohjfmgdeefhmlchcbkmnjfmkgenapa
# Optional extra full origins (comma-separated), e.g. integration tests: https://test.example.com
# PROTECTED_RPC_ALLOWED_ORIGINS=https://test.example.com
# Optional logical id for GET /api/protected/rpc/chains (default 102; distinct from Sui 101 in public /api/rpc/chains).
# SOLANA_PROXY_CHAIN_ID=102

# Vault legacy (/api/vault-legacy/*): max wait for on-chain tx confirmation (ms); Pinata JSON/gateway timeout for legacy manifest IPFS calls
# LEGACY_TX_WAIT_TIMEOUT_MS=120000
# LEGACY_IPFS_REQUEST_TIMEOUT_MS=30000

INFURA_APIKEY=your-secret-here
# Etherscan API V2 (gas oracle, etc.): https://etherscan.io/apidashboard — not an Infura key
ETHERSCAN_API_KEY=your-etherscan-api-key
# Optional override (default https://api.etherscan.io/v2/api)
# ETHERSCAN_V2_API=
# Optional overrides for gas-tracker RPC fallback (mainnet / Sepolia)
ETH_MAINNET_RPC_URL=
ETH_SEPOLIA_RPC_URL=
ALCHEMY_API_KEY=your-secret-here
QUCIKNODE_API_KEY=your-secret-here
BSCSCAN_API_KEY=your-secret-here
POLYGONSCAN_API_KEY=your-secret-here
POLYGONSCAN_API_URL=https://example.com
POLYGON_RPC_URL=https://example.com
DEBUG_POLYGON=1
DEBUG_BSC=1
API_KEY_ETH=your-secret-here
OKLINK_API_KEY=your-secret-here


# =============================================================================
# SourceA NaaS (Blockbook / JSON-RPC fallback provider)
# =============================================================================

# Session ID from your NaaS dashboard — used to authenticate fallback RPC/Blockbook requests.
SOURCE_A_SESSION_ID=your-session-id-here

# Per-chain hostnames (hostname only, no https:// prefix).
# SOURCE_A_DEFAULT_HOST can be used as a single fallback if all chains share one host.
# Per-chain vars take priority over SOURCE_A_DEFAULT_HOST.
SOURCE_A_DEFAULT_HOST=your-default-host-here
SOURCE_A_BTC_HOST=your-btc-host-here
SOURCE_A_SOLANA_HOST=your-solana-host-here
SOURCE_A_POLYGON_HOST=your-polygon-host-here
SOURCE_A_ETHEREUM_HOST=your-ethereum-host-here
SOURCE_A_BSC_HOST=your-bsc-host-here

# Optional per-chain full URL overrides — if set, SOURCE_A_*_HOST and SOURCE_A_SESSION_ID
# are not needed for that chain (full URL takes full precedence):
# BTC_BOOK_FALLBACK_URL=
# SOLANA_BOOK_FALLBACK_URL=
# POLYGON_BOOK_FALLBACK_URL=
# BSC_BOOK_FALLBACK_URL=
# ETHPLORER_FALLBACK_RPC_URL=


# =============================================================================
# Walrus / Sui
# =============================================================================

WALRUS_PRIVATE_KEY=your-secret-here


# =============================================================================
# Google / Captcha / Gemini
# =============================================================================

GOOGLE_APPLICATION_CREDENTIALS=your-value-here
CAPTCHA_PROJECT_ID=your-id-here
CAPTCHA_WEB_SITE_KEY=your-secret-here
CAPTCHA_ANDROID_SITE_KEY=your-secret-here
CAPTCHA_IOS_SITE_KEY=your-secret-here
CAPTCHA_APPROVAL=true


# =============================================================================
# LiFi
# =============================================================================

LIFI_URL=https://example.com
LIFI_API_KEY=your-secret-here
LIFI_INTEGRATOR=your-value-here


# =============================================================================
# AI / OpenAI
# =============================================================================

OPENAI_API_KEY=your-secret-here
CLAUDE_APIKEY=your-secret-here


# =============================================================================
# Vault Legacy (inheritance plans / Avalanche VaultRegistry)
# =============================================================================

LEGACY_JWT_SECRET=your-secret-here
LEGACY_AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
LEGACY_VAULT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
LEGACY_RELAYER_PRIVATE_KEY=your-secret-here

# Demo wills only — NEVER enable on production v4.zelf.world
LEGACY_DEMO_MODE=false
LEGACY_DEMO_LAWYER_ADDRESS=0x0000000000000000000000000000000000000000
# Optional if demo lawyer differs from relayer wallet
# LEGACY_DEMO_LAWYER_PRIVATE_KEY=your-secret-here
# Shorter heartbeat for staging demos (seconds; default 2592000 = 30 days)
# LEGACY_DEMO_HEARTBEAT_INTERVAL=86400


# =============================================================================
# WhatsApp relay (Verifik → Zelf → Meta Graph API)
# Required on v4.zelf.world for multi-sender relay (Verifik default + TCC).
# =============================================================================

# Default Verifik WABA
WHATSAPP_API_TOKEN=your-secret-here
WHATSAPP_API_PHONE_IDENTIFIER=93849389333112

# TCC WABA — same token value as Verifik prod TCC_WHATSAPP_API_KEY
TCC_WHATSAPP_API_KEY=your-secret-here

# Shared secret for Verifik relay requests (X-API-Key header)
VERIFIK_WHATSAPP_RELAY_API_KEY=your-secret-here

# Optional: additional phoneId → token map without code changes, e.g. '{"999888777666":"token"}'
# WHATSAPP_EXTRA_API_KEYS=


# =============================================================================
# Misc
# =============================================================================

# Jest integration (jest.integration.config.js): globalSetup retries connecting to mongodb://localhost:27017/zelf_testing
# JEST_MONGO_MAX_ATTEMPTS=60
# JEST_MONGO_RETRY_DELAY_MS=1000
# Optional: base URL for integration tests (default http://127.0.0.1:$PORT). Do not point at production unless that stack exposes the same routes.
# API_INTEGRATION_BASE_URL=http://127.0.0.1:3003

SECRET_KEY_PRICI=your-secret-here
REVENUECAT_ALLOWED_EMAIL=your@email.com
SWITCHOFF_ONE_SIGNAL=0
FACE_PKI_KEY=your-secret-here
API_SERVER=your-value-here
CLIENT_ZELF_EMAIL=your@email.com
CLIENT_ZELF_API_KEY=your-secret-here
OX_KEY=your-secret-here
STORACHA_EMAIL=your@email.com
STORACHA_PRIVATE_KEY=your-secret-here
STORACHA_PROOF=your-value-here
STORACHA_SPACE_DID=your-id-here
MICROSERVICES_BOGOTA_URL=https://example.com
MICROSERVICES_BOGOTA_TOKEN=your-value-here


# =============================================================================
# Push for received transfers (Repositories/TxNotifications, `npm run tx-watcher`)
# =============================================================================
# OneSignal app (same app id for Android and iOS). The app API key is IP-allowlisted
# to the production server; from any other machine OneSignal answers 401.
ONESIGNAL_APP_ID=e8a5079a-3958-4261-9b23-6a9459f0e118
ONESIGNAL_APP_API_KEY=your-secret-here
# Watcher: never call OneSignal, only log and write the push log.
# TX_WATCHER_DRY_RUN=false
# TX_WATCHER_TICK_MS=60000
# TX_WATCHER_ADDRESS_INTERVAL_MS=120000
# TX_WATCHER_LEASE_MS=180000
# TX_WATCHER_MAX_CURSORS_PER_TICK=600
# TX_PUSH_MAX_INDIVIDUAL_PER_CYCLE=3
# TX_PUSH_DEVICE_STALE_DAYS=60
# Chain sources (defaults are public endpoints). EVM lists are CSV and tried first.
# SUI_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql
# STELLAR_HORIZON_URL=https://horizon.stellar.org
# BITCOIN_ESPLORA_URLS=https://mempool.space/api,https://blockstream.info/api
# BLOCKDAG_SCAN_API_URL=https://api.bdagscan.com/v1/api
# TX_WATCHER_BSC_RPC_URLS=
# TX_WATCHER_ETHEREUM_RPC_URLS=
# TX_WATCHER_POLYGON_RPC_URLS=
# TX_WATCHER_AVALANCHE_RPC_URLS=

# =============================================================================
# Other
# =============================================================================

miguel=your-value-here
