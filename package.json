        "test:aptos": "jest tests/unit/aptos-wallet.test.js tests/unit/aptos-format.util.test.js tests/unit/tags-addresses.module.test.js --verbose --no-coverage && jest tests/integration/aptos-live.test.js --verbose --no-coverage",
        "test:canton": "jest tests/unit/canton-format.util.test.js tests/unit/canton-sdk.client.test.js tests/unit/canton-transfer.module.test.js tests/unit/canton.middleware.test.js --verbose --no-coverage && jest --config jest.integration.http.config.js tests/integration/canton-api.test.js --verbose --no-coverage && jest --config jest.integration.config.js tests/integration/canton-live.test.js --verbose --no-coverage",
