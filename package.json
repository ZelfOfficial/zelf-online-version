{
    "scripts": {
        "start": "nodemon server.js --delay=3s",
        "preinstall": "npx npm-force-resolutions",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:unit": "jest tests/unit",
        "test:integration": "jest --config jest.integration.config.js tests/integration",
        "test:e2e": "jest tests/e2e",
        "test:ci": "jest --ci --coverage --watchAll=false",
        "test:lease": "jest tests/integration/leaseTags-api.test.js --verbose --no-coverage",
        "test:search-tag": "jest tests/integration/searchTags-api.test.js --verbose --no-coverage",
        "test:preview-tag": "jest tests/integration/previewTags-api.test.js --verbose --no-coverage",
        "test:search-by-domain": "jest tests/integration/searchByDomain-api.test.js --verbose --no-coverage",
        "test:lease-offline": "jest tests/integration/leaseOffline-api.test.js --verbose --no-coverage",
        "test:decrypt-tag": "jest tests/integration/decryptTag-api.test.js --verbose --no-coverage",
        "test:lease-recovery": "jest tests/integration/leaseRecovery-api.test.js --verbose --no-coverage",
        "test:authentication": "jest tests/integration/authentication.test.js --verbose --no-coverage",
        "test:app-version": "jest tests/integration/app-version-api.test.js --config jest.integration.config.js --verbose --no-coverage",
        "test:license": "jest tests/integration/license.test.js --verbose --no-coverage",
        "test:human-authn-onboarding": "jest --config jest.integration.config.js tests/integration/human-authn-onboarding-api.test.js --verbose --no-coverage",
        "test:vault-legacy": "jest tests/unit/vault-legacy-removed.test.js --verbose --no-coverage",
        "test:license-theme": "jest tests/unit/license-theme-merge.test.js --verbose --no-coverage && jest --config jest.integration.http.config.js tests/integration/license-zelf-theme-api.test.js --verbose --no-coverage",
        "test:stellar": "jest tests/integration/stellar-api.test.js --verbose --no-coverage",
        "test:ton": "jest tests/unit/ton-wallet.test.js --verbose --no-coverage && jest --config jest.integration.config.js tests/integration/ton-api.test.js --verbose --no-coverage",
        "test:ethereum-gas": "jest tests/unit/etherscan-gas-tracker.util.test.js --verbose --no-coverage && jest --config jest.integration.config.js tests/integration/ethereum-gas-tracker-live.test.js --verbose --no-coverage",
        "test:avalanche-rpc": "jest --config jest.integration.config.js tests/integration/avalanche-rpc-live.test.js --verbose --no-coverage",
        "test:sui-rpc": "jest --config jest.integration.config.js tests/integration/sui-rpc-live.test.js --verbose --no-coverage",
        "test:solana-transfer": "jest tests/integration/solana-token-transfer.test.js --verbose --no-coverage",
        "test:blogs": "jest --config jest.integration.http.config.js tests/integration/blogs-api.test.js --verbose --no-coverage",
        "test:zelf-ids": "jest --config jest.integration.http.config.js tests/integration/zelf-ids-api.test.js --verbose --no-coverage",
        "status:check": "node scripts/run-status-check.js",
        "status:check:zelf-ids": "node scripts/run-status-check.js --suite=zelf-ids",
        "audit:ipfs-pay-balances": "node scripts/audit-ipfs-pay-tags-balances.js",
        "repair:blockdag-nft-index": "node scripts/reconcile-blockdag-nft-index.js",
        "deploy:checkout-avax": "node checkoutContracts/scripts/deploy-zelf-avalanche-pay.js",
        "deploy:checkout-bsc": "node checkoutContracts/scripts/deploy-zelf-bsc-pay.js",
        "deploy:checkout-eth": "node checkoutContracts/scripts/deploy-zelf-eth-pay.js",
        "deploy:checkout-polygon": "node checkoutContracts/scripts/deploy-zelf-polygon-pay.js",
        "deploy:checkout-base": "node checkoutContracts/scripts/deploy-zelf-base-pay.js",
        "deploy:checkout-blockdag": "node checkoutContracts/scripts/deploy-zelf-blockdag-pay.js"
    },
    "name": "zelf-wallet",
    "description": "zelf wallet backend",
    "version": "1.0.0",
